MOCK_LLM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DATABASE_PATH=./reviews.db
# Optional comma-separated exact origins for browser clients that need CORS.
# A Chrome extension origin, if needed, is chrome-extension:// followed by its actual ID.
CORS_ORIGINS=

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
