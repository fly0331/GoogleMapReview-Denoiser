MOCK_LLM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_PATH=./reviews.db
# Optional comma-separated exact origins for browser clients that need CORS.
# A Chrome extension origin, if needed, is chrome-extension:// followed by its actual ID.
CORS_ORIGINS=

FORWARDED_ALLOW_IPS=
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_CLIENTS=10000
MAX_REQUEST_BODY_BYTES=524288
GEMINI_DAILY_CALL_LIMIT=100
GEMINI_CONCURRENT_CALL_LIMIT=2
GEMINI_MAX_REQUEST_BYTES=262144
GEMINI_MAX_OUTPUT_TOKENS=4096
